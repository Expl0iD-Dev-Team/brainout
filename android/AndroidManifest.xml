<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- package / versionCode / versionName / uses-sdk are declared in
         android/build.gradle (AGP 8 requirement). -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- KeepConnectionService: keeps the match connected for a few minutes
         while the game is in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The client talks to a user-supplied server over plain TCP/UDP/HTTP
         (default ports 36555/36556/36557). Android 9+ blocks cleartext HTTP by
         default, so allow it for the direct-connect / self-hosted use case. -->
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/GdxTheme" >
        <activity
            android:name="com.desertkun.brainout.android.AndroidLauncher"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|locale|layoutDirection|colorMode">
            <!-- The engine keeps its state in statics, so the activity must never
                 be recreated for a configuration change (dark theme, font size,
                 split screen...), and a deep link must reuse the running game
                 instead of starting a second one (singleTask). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Direct-connect deep link: brainout://<base64 of host;tcp;udp;http>
                 Opening such a link launches the client straight into the
                 connection flow (see AndroidLauncher / IntroMenu). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="brainout" />
            </intent-filter>
        </activity>

        <service
            android:name="com.desertkun.brainout.android.KeepConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a multiplayer game session connected while the player briefly switches apps" />
        </service>
    </application>

</manifest>
