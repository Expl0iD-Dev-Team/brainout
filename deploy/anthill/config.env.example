# Copy to deploy/anthill/config.env and fill in. config.env is git-ignored.

# The server's public (static) IP address. Clients and the APK use it; the HTTPS
# certificate is issued for it.
PUBLIC_HOST=203.0.113.10

# Public HTTPS port of each service = its internal port + this offset, so the
# services end up on 19501-19519. Forward that range from the router.
TLS_PORT_OFFSET=10000

# Game rooms take three ports each (TCP, UDP, HTTP) from this range. Forward it
# from the router for both TCP and UDP. 21 ports are enough for 7 rooms.
PORTS_FROM=38000
PORTS_TO=38020

# Game server build to deploy: the brainout-server-<version>.tar.gz from a
# GitHub Actions run or release. Leave empty to use bin/server from a local
# ./gradlew make_data server:dist instead.
SERVER_BUNDLE=

# Where backup.sh writes database dumps.
BACKUP_DIR=/var/backups/brainout
